{
  "name": "jagawarga",
  "private": true,
  "version": "0.13.0-rc.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:launch-gate": "node scripts/test-launch-gate.mjs",
    "test:openapi": "node scripts/test-openapi.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "launch:gate": "node scripts/launch-gate.mjs",
    "acceptance:local": "npm run build && node scripts/local-acceptance.mjs",
    "acceptance:runtime": "node scripts/local-acceptance.mjs",
    "performance:proof": "tsx scripts/performance-proof.ts",
    "operations:proof": "node scripts/operational-proof.mjs",
    "reproducibility:proof": "node scripts/reproducibility-proof.mjs",
    "release:verify": "node scripts/verify-release-candidate.mjs",
    "local:env": "node scripts/init-local-deploy.mjs",
    "local:up": "npm run local:env && docker compose --env-file .env.local-deploy up --build -d --wait --force-recreate",
    "local:down": "docker compose --env-file .env.local-deploy down",
    "local:verify": "node scripts/local-verify.mjs",
    "deploy:init": "node deploy/self-hosted/init-env.mjs",
    "deploy:verify": "node deploy/self-hosted/verify-config.mjs",
    "preflight": "node scripts/preflight.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "ipaddr.js": "2.2.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
