{
  "openapi": "3.1.0",
  "info": { "title": "JagaWarga API", "version": "0.9.0", "description": "Existing-lookup-only security awareness API." },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/live": { "get": { "summary": "Process liveness", "responses": { "200": { "description": "Alive" } } } },
    "/api/ready": { "get": { "summary": "Runtime readiness", "responses": { "200": { "description": "Ready" }, "503": { "description": "Not ready" } } } },
    "/api/health": { "get": { "summary": "Health status", "responses": { "200": { "description": "Healthy" } } } },
    "/api/version": { "get": { "summary": "Version and policy", "responses": { "200": { "description": "Version" } } } },
    "/api/policy": { "get": { "summary": "Feature and privacy policy", "responses": { "200": { "description": "Policy" } } } },
    "/api/metrics": { "get": { "summary": "Protected privacy-safe metrics", "responses": { "200": { "description": "Metrics" }, "401": { "description": "Unauthorized" } } } },
    "/api/lookups": {
      "post": {
        "summary": "Metadata lookup",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["indicator"], "properties": { "indicator": { "type": "string", "maxLength": 2048 } } } } } },
        "responses": { "200": { "description": "Lookup result" }, "400": { "description": "Invalid input" }, "413": { "description": "Payload too large" }, "429": { "description": "Rate limited" } }
      }
    },
    "/api/analyze/message": {
      "post": {
        "summary": "Explainable message analysis",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "maxLength": 10000 } } } } } },
        "responses": { "200": { "description": "Analysis" }, "400": { "description": "Invalid input" }, "429": { "description": "Rate limited" } }
      }
    },
    "/api/analyze/email-header": {
      "post": {
        "summary": "Email-header analysis",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["headers"], "properties": { "headers": { "type": "string", "maxLength": 50000 } } } } } },
        "responses": { "200": { "description": "Analysis" }, "400": { "description": "Invalid input" }, "429": { "description": "Rate limited" } }
      }
    },
    "/api/feedback": {
      "post": {
        "summary": "Indicator-free feedback",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["helpful"], "properties": { "helpful": { "type": "boolean" }, "category": { "type": "string", "maxLength": 40 } } } } } },
        "responses": { "200": { "description": "Accepted" }, "429": { "description": "Rate limited" } }
      }
    }
  }
}