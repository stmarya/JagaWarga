# JagaWarga Cloud Production Deployment Environment
# Domain: https://jagawarga.cloud

# 1. Domain & Proxy Configuration
PUBLIC_HOST=jagawarga.cloud
CADDY_DOMAINS=jagawarga.cloud, www.jagawarga.cloud
# Operator email for Let's Encrypt TLS certificate renewal notifications
ACME_EMAIL=admin@jagawarga.cloud

# 2. Application & Container Image
# Can be local build name or immutable GHCR digest
IMAGE_REF=jagawarga:0.13.0-rc.4
APP_IMAGE_DIGEST=sha256:build
APP_VERSION=0.13.0-rc.4

# 3. Security Tokens (Generate random string, e.g.: openssl rand -base64 32)
ADMIN_METRICS_TOKEN=change-me-to-a-very-long-random-string-min-32-chars

# 4. Intelligence Providers (Optional / Recommended)
FEATURE_PREMIUM_PROVIDERS=true
VIRUSTOTAL_API_KEYS=
VIRUSTOTAL_API_KEY=

# 5. AI Assistant (Groq)
GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 6. DNS Resolvers (Do not disable unless debugging)
DISABLE_CLOUDFLARE_DNS=false
DISABLE_GOOGLE_DNS=false
