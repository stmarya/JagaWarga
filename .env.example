# Never commit real API keys
APP_URL=http://localhost:3000
APP_VERSION=0.13.0-rc.2
APP_IMAGE_DIGEST=
ADMIN_METRICS_TOKEN=
ALLOW_RISKY_FEATURES=false
FEATURE_COMMUNITY_REPORTING=false
FEATURE_FILE_UPLOAD=false
FEATURE_URL_SUBMISSION=false
FEATURE_PREMIUM_PROVIDERS=false
FEATURE_EXTERNAL_NOTIFICATIONS=false
FEATURE_ORGANIZATION_WORKSPACES=false
DISABLE_CLOUDFLARE_DNS=false
DISABLE_GOOGLE_DNS=false
REDIS_URL=redis://localhost:6379
RUNTIME_TOPOLOGY=single
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
# Preferred: comma-separated VirusTotal key pool. On HTTP 429 the next key is
# tried in the same request. The exhausted key is skipped until the next UTC day.
VIRUSTOTAL_API_KEYS=
# Backward-compatible single-key setting (used only when the pool is empty).
VIRUSTOTAL_API_KEY=
# Groq Cloud API Key for AI Assistant (Llama 3.3 70B)
GROQ_API_KEY=